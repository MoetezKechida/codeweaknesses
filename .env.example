# Database Configuration
# Choose one: 'postgres' or 'mysql' or 'sqlite'
DB_TYPE=postgres

# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres123
DB_NAME=codeweaknesses

# MySQL Configuration (if using mysql)
# DB_HOST=localhost
# DB_PORT=3306
# DB_USERNAME=root
# DB_PASSWORD=root123
# DB_NAME=codeweaknesses

# SQLite Configuration (if using sqlite)
# DB_DATABASE=codeweaknesses.db

# Redis Configuration (for BullMQ Job Queue)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRATION=24h
